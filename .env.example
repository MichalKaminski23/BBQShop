# Skopiuj do .env i dostosuj: cp .env.example .env

# --- Bazy danych ---
BBQ_POSTGRES_DSN=postgresql+asyncpg://bbq:bbq@localhost:5432/bbqshop
BBQ_MONGO_URI=mongodb://localhost:27017
BBQ_MONGO_DB=bbqshop

# Czy przy starcie API wypełniać bazę danymi przykładowymi (idempotentnie).
BBQ_SEED_ON_STARTUP=true

# --- Moduły podatności ---
# Wartości: vulnerable | secure | off
# Domyślny wariant dla modułów bez własnego ustawienia (bezpiecznie: secure).
BBQ_DEFAULT_VARIANT=secure

# Ustawienia per moduł (nazwa modułu wielkimi literami).
BBQ_MODULE_SQLI=vulnerable
BBQ_MODULE_NOSQLI=vulnerable
